{
  "name": "hiway",
  "version": "1.0.0",
  "description": "HiWay - futuristic task and productivity manager for Mac and Windows",
  "main": "main.js",
  "author": "hugging-phace",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.hiway.app",
    "productName": "HiWay",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*"
    ],
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "chart.js": "^4.4.3"
  }
}
