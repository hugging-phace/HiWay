{
  "name": "hiway",
  "version": "1.0.87",
  "description": "Onward - a futuristic task and productivity manager.",
  "main": "main.js",
  "author": "hugging-phace",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.hiway.app",
    "productName": "Onward",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "!build/appx"
    ],
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "build/icon.icon"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "appx": {
      "displayName": "Onward: Task Manager",
      "identityName": "aramoon.OnwardTaskManager",
      "applicationId": "Onward",
      "publisher": "CN=0B9E00D9-5265-4D28-955C-12EA771F1F35",
      "publisherDisplayName": "aramoon",
      "backgroundColor": "#1a0b2e",
      "artifactName": "Onward-${version}.msix",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.19041.0"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "@litejs/xlsx": "^26.8.0",
    "chart.js": "^4.4.3"
  },
  "keywords": [],
  "license": "ISC"
}
