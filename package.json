{
  "name": "hiway",
  "version": "1.0.26",
  "description": "Onward - futuristic task and productivity manager for Mac and Windows",
  "main": "main.js",
  "author": "hugging-phace",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.hiway.app",
    "productName": "Onward",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*"
    ],
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "build/icon.icon"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "@litejs/xlsx": "^26.8.0",
    "chart.js": "^4.4.3"
  }
}
